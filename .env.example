# Hosted Portal configuration (copy to .env.local for `npm run dev`; set the same names in Vercel).
# Browser-visible: only the project URL and the public anon key may use the VITE_ prefix.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
# Optional server override; must be the same project as VITE_SUPABASE_URL.
SUPABASE_URL=
# Server only; never prefix these with VITE_
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
NOTIFICATION_FROM=Vexora <portal@vexoradigital.com>
CRON_SECRET=

# Vexbot (server only; never prefix with VITE_). Portal-owned credentials only, never the website's.
# Without OPENAI_API_KEY + VEXBOT_OPENAI_MODEL, Vexbot reports that answers are unavailable.
OPENAI_API_KEY=
VEXBOT_OPENAI_MODEL=
# Optional server-only structured-output model for conversation summaries; defaults to the answer model.
VEXBOT_SUMMARY_MODEL=
# Opt-in history expiry, at least 30 days. Unset preserves existing activity and conversations.
PORTAL_INSIGHTS_RETENTION_DAYS=
# Both are needed for turn-based voice (transcription and spoken replies).
VEXBOT_TRANSCRIBE_MODEL=
VEXBOT_TTS_MODEL=
VEXBOT_TTS_VOICE=
# Server only. Enable after applying the reviewed vexbot_realtime_sessions migration.
# Realtime identity is fixed in server/vexbot/realtime.mjs: gpt-realtime-2.1-mini with the cedar voice.
# Recorded replies default to the ash voice; set VEXBOT_TTS_VOICE only to override it.
VEXBOT_REALTIME_ENABLED=false
# Malware scanning. Without a scanner every upload stays quarantined (fail closed).
VEXBOT_CLAMD_HOST=
VEXBOT_CLAMD_PORT=3310
# Local development only: VEXBOT_PROVIDER=mock and VEXBOT_SCANNER=mock. Both are refused on every Vercel deployment.

# Optional explicit selection: resend (legacy default), disabled, gmail.
# Supabase Auth SMTP is configured independently in Supabase, never here.
EMAIL_DELIVERY_PROVIDER=resend

# Foundation only. Leave disabled until a separately approved connection phase.
GMAIL_INTEGRATION_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GMAIL_EXPECTED_MAILBOX=
GMAIL_ALLOWED_DOMAIN=
# JSON object of key IDs to base64-encoded, random 32-byte keys. No real keys belong here.
GMAIL_TOKEN_ENCRYPTION_KEYS=
GMAIL_ACTIVE_KEY_ID=
# Separate base64-encoded, random 32-byte OAuth-state signing key.
GMAIL_STATE_SIGNING_KEY=
# Set only after explicit approval of a designated SYSTEM notification connection.
EMAIL_GMAIL_SYSTEM_ORGANISATION_ID=
EMAIL_GMAIL_SYSTEM_CONNECTION_ID=
