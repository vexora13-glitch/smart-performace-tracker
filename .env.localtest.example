# Copy to .env.localtest.local for `npm run dev:localtest` (http://localhost:5186).
# LOCAL Supabase stack only (`supabase start`; values from `supabase status -o env`). dev.mjs refuses to start
# in this mode unless both URLs are loopback. Never put hosted Portal credentials here.
VITE_SUPABASE_URL=http://127.0.0.1:56421
VITE_SUPABASE_ANON_KEY=local-anon-key-from-supabase-status
SUPABASE_URL=http://127.0.0.1:56421
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-from-supabase-status

# openai = real answers/voice with a portal-owned key; mock = labelled offline stand-in.
VEXBOT_PROVIDER=openai
OPENAI_API_KEY=
VEXBOT_OPENAI_MODEL=gpt-4.1-mini
VEXBOT_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
VEXBOT_TTS_MODEL=tts-1

# clamd = local ClamAV container (docker, 127.0.0.1:3310); mock = EICAR-only stand-in; empty = quarantine all.
VEXBOT_SCANNER=clamd
VEXBOT_CLAMD_HOST=127.0.0.1
VEXBOT_CLAMD_PORT=3310
